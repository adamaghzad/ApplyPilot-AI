# ---------------------------------------------------------------------------
# ApplyPilot AI — environment
# Copy to `.env` (`cp .env.example .env`). Only APP_URL is required in dev;
# everything else has a safe default. Nothing here costs money.
# ---------------------------------------------------------------------------

APP_URL="http://localhost:3000"
NODE_ENV="development"

# Local embedded Postgres (PGlite). No server to install. For a hosted
# Postgres set DATABASE_URL="postgresql://user:pass@host:5432/applypilot".
DATABASE_URL="file:./.pgdata"

# openssl rand -hex 32
AUTH_SECRET="replace-with-openssl-rand-hex-32"
# 32-byte key used to AES-256-GCM encrypt OAuth tokens at rest.
# openssl rand -base64 32
ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# ---------------------------------------------------------------------------
# AI MODELS — optional, and free by default
# ---------------------------------------------------------------------------
# ApplyPilot ships a deterministic local engine that needs no model at all:
# it scores matches, drafts emails and writes cover letters from your real CV.
# If you want an LLM on top, pick ONE of the free options below.
#
#   AI_PROVIDER   auto | openai | openrouter | groq | gemini | ollama | custom
#   AI_MODEL      optional model override (leave empty for the provider default)
#
# FREE OPTION 1 — Ollama, local, zero cost, zero data leaving your machine
#   1. install  https://ollama.com/download
#   2. pull     ollama pull llama3.2
#   3. run      ollama serve
#   4. set      AI_PROVIDER="ollama"
#
# FREE OPTION 2 — OpenRouter `:free` models (no paid plan)
#   1. create account  https://openrouter.ai/keys
#   2. set             OPENROUTER_API_KEY="sk-or-v1-..."
#   default model: meta-llama/llama-3.3-70b-instruct:free
#
# FREE OPTION 3 — Groq free tier
#   1. create account  https://console.groq.com/keys
#   2. set             GROQ_API_KEY="gsk_..."
#   default model: llama-3.3-70b-versatile
#
# FREE OPTION 4 — Google Gemini free tier
#   1. create key  https://aistudio.google.com/apikey
#   2. set         GEMINI_API_KEY="..."
#   default model: gemini-2.5-flash
#
# PAID OPTION — OpenAI (only if you want it)
#   OPENAI_API_KEY="sk-..."        default model: gpt-4o-mini
#
AI_PROVIDER="auto"
AI_MODEL=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Mailbox integrations — required to actually SEND. Without them the app is
# fully usable but every application stays in the approval queue (by design).
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: http://localhost:3000/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: sign-in with Google (same credentials can be reused).
# Redirect URI: http://localhost:3000/api/auth/google/callback

# Azure Portal → App registrations → New registration → Web.
# Redirect URI: http://localhost:3000/api/integrations/outlook/callback
# API permissions: Mail.Send, Mail.ReadWrite, offline_access (delegated)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ---------------------------------------------------------------------------
# Jobs & storage
# ---------------------------------------------------------------------------
# BullMQ worker. Leave empty to run queued jobs inline (fine for single-user).
REDIS_URL=""
# Where uploaded CVs and generated documents are written.
STORAGE_DIR="./storage"
# When true the demo-data endpoint is enabled and demo records are badged.
DEMO_MODE="true"
